NODE_ENV=development
PORT=3000
HOST=127.0.0.1

DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=fitapp_dev
DB_PASSWORD=
DB_NAME=fitapp_dev

# "disable" for the local database, "verify" for a remote one (requires DB_CA_FILE).
DB_SSL=disable
# Path to the CA certificate file. Only needed when DB_SSL=verify.
# DB_CA_FILE=C:\path\to\ca.pem